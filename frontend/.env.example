# Vercel Frontend Environment Variables
# Set VITE_API_BASE_URL to your Render backend API URL (for example: https://krishirakshak-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Gemini API Key for intelligent voice assistant
# Do not commit a real secret. Add your key in a local .env file at runtime instead.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
