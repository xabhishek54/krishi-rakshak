# Local free voice stack
# Piper TTS
PIPER_BINARY=piper
PIPER_MODEL_PATH=/opt/piper/en_US-lessac-medium.onnx
PIPER_VOICE=en_US-lessac-medium
PIPER_DATA_DIR=/opt/piper

# Vosk STT
VOSK_MODEL_PATH=/opt/vosk/model-small-en-in

# Optional: toggle browser fallback for non-supported browsers
VOICE_FALLBACK_BROWSER=true
