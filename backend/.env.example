# Backend Environment Variables (Render / Local)

# Supabase PostgreSQL Pooler Connection String (for Render IPv4 support)
# Format: postgresql://postgres.hockhqxmnwdopfclilhu:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./krishirakshak.db

# JWT Secret Key for Authentication
SECRET_KEY=replace_with_a_secure_secret

# Port (Render automatically sets PORT=10000 or similar)
PORT=8000

# Local TTS / ASR configuration
PIPER_BINARY=piper
PIPER_MODEL_PATH=/opt/piper/en_US-lessac-medium.onnx
PIPER_VOICE=en_US-lessac-medium
VOSK_MODEL_PATH=/opt/vosk-model-small-en-us-0.15
