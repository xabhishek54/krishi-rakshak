# Backend Environment Variables (Render / Local)

# Supabase PostgreSQL Connection String (or local SQLite fallback)
# Format: postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./krishirakshak.db

# JWT Secret Key for Authentication
SECRET_KEY=krishirakshak_secret_key_sih_hackathon_2026_default

# Port (Render automatically sets PORT=10000 or similar)
PORT=8000
